{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The page cache in front of the generated Next.js worker (.open-next/worker.js)
  "main": "custom-worker.js",
  "name": "shahnoori",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "shahnoori"
    }
  ],
  // The deployment's id: kept pages are filed per version, so a new version never serves old pages
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "images": {
    "binding": "IMAGES"
  }
}
